{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sumit/Github/conjecture_machine/tools/blind_hook.sh",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Blinding guard: checking outgoing message"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/sumit/Github/conjecture_machine/tools/zsh_cmdvar_hook.py",
            "timeout": 10,
            "statusMessage": "zsh guard: checking for $VAR used as a command"
          }
        ]
      }
    ]
  }
}